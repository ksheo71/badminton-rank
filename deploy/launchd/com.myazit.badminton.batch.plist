<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  셔틀랭크(badminton) 야간 배치 — 맥미니 launchd.
  설치:
    cp deploy/launchd/com.myazit.badminton.batch.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.myazit.badminton.batch.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.myazit.badminton.batch.plist
  즉시 1회 실행(테스트): launchctl start com.myazit.badminton.batch
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.myazit.badminton.batch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/opt/stack/services/public/myazit.kr/badminton-rank/repo/scripts/wikipedia-batch.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>20</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/opt/stack/services/public/myazit.kr/badminton-rank/batch.out</string>
  <key>StandardErrorPath</key>
  <string>/opt/stack/services/public/myazit.kr/badminton-rank/batch.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
